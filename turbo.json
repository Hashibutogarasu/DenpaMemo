{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "container:run": {
      "cache": false
    },
    "build:wasm": {
      "inputs": ["rust/src/**", "rust/Cargo.toml"],
      "outputs": ["pkg-node/**"]
    },
    "dev": {
      "dependsOn": ["container:run", "@denpamemo/denpamemo-logics#build:wasm"],
      "cache": false,
      "persistent": true
    },
    "dev:deploy": {
      "cache": false
    },
    "build": {
      "dependsOn": ["@denpamemo/denpamemo-logics#build:wasm"]
    }
  }
}
