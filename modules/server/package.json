{
  "name": "@denpa-memo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:remove": "docker compose down -v",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:deploy": "docker compose up -d postgres",
    "db:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/config/data-source.ts",
    "db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/config/data-source.ts",
    "db:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/data-source.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elysiajs/node": "^1.4.5",
    "@paralleldrive/cuid2": "^2.2.2",
    "ajv": "^8.17.1",
    "dotenv": "^17.4.2",
    "elysia": "^1.1.26",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
